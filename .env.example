# Teste local: empresas fictícias, nenhum contato enviado.
APP_ENV=development
DATABASE_URL=sqlite:///./leads.db
ADMIN_API_KEY=local-demo-key-change-me
SEARCH_PROVIDER=demo
PORT=8000

# Pesquisa real: mude SEARCH_PROVIDER para overpass.
OVERPASS_URL=https://overpass-api.de/api/interpreter
SEARCH_CACHE_HOURS=24
PROVIDER_INTERVAL_SECONDS=60

# Opcional: análise da empresa e respostas comerciais por IA.
# Sem chave, as respostas usam regras e encaminham dúvidas ao responsável.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Agente 2: API oficial da Meta. Envio desligado até a configuração completa.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
# ID numérico mostrado na Meta; não é o telefone com DDD.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Escolha um valor próprio e repita na configuração do webhook da Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v24.0
# Cadastre e obtenha aprovação do template descrito em AGENTE-2.md.
WHATSAPP_TEMPLATE_NAME=atendeai_apresentacao
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
COMMERCIAL_AUTO_REPLY=true
COMMERCIAL_DAILY_LIMIT=100
COMMERCIAL_MAX_AUTO_REPLIES=6

# Hospedagem: APP_ENV=production, SEARCH_PROVIDER=overpass e PostgreSQL.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Square Cloud: certificate.pem combinado, codificado em Base64.
DATABASE_SSL_PEM_B64=
# Alternativa: CA, certificado e chave separados (preencha as três juntas).
DATABASE_SSL_CA_B64=
DATABASE_SSL_CERT_B64=
DATABASE_SSL_KEY_B64=
# Com certificados, usa verify-ca por padrão; verify-full também é aceito.
DATABASE_SSL_MODE=
# Gere ADMIN_API_KEY com: python manage.py gerar-chave
# Cadastre segredos nas variáveis da hospedagem; não envie senhas no chat.

# Agente 3: credenciais por empresa, somente no ambiente. Veja AGENTE-3.md.
SUPPORT_WHATSAPP_ACCOUNTS_JSON={}
# Demonstração pública de site, sem uso de IA paga; false para desativar.
SUPPORT_DEMO_ENABLED=true
